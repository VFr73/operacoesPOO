public enum TipoOperacao {
    GRAVAR_TXT(1, "Gravar arquivo TXT"),
    GRAVAR_CSV(2,"Gravar arquivo CSV"),
    GRAVAR_TEXTO_FIXO(3, "Gravar arquivo texto fixo"),
    GRAVAR_ARQUIVO(4, "Copiar arquivo"),
    SAIR(0, "Sair");

    private final int codigo;
    private final String descricao;

    private TipoOperacao(int codigo, String descricao) {
        this.codigo = codigo;
        this.descricao = descricao;
    }

    public static TipoOperacao escolhaCodico(int codigo) {
        for(TipoOperacao t : TipoOperacao.values()) {
            if(t.getCodigo() == codigo) {
                return t;
            }
        }
        return null;
    }

    public int getCodigo() {
        return codigo;
    }
    public String getDescricao() {
        return descricao;
    }


}
